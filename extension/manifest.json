{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "version": "1.3.1",
    "description": "__MSG_extDescription__",
    "default_locale": "en",
    "minimum_chrome_version": "116",
    "homepage_url": "https://github.com/kilicberkay/FillHub",
    "permissions": [
        "storage",
        "contextMenus",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "__MSG_actionTitle__",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/logo16.png",
            "48": "icons/logo48.png",
            "128": "icons/logo128.png"
        }
    },
    "icons": {
        "16": "icons/logo16.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "options_page": "options/options.html",
    "commands": {
        "fill_form": {
            "suggested_key": {
                "default": "Ctrl+Shift+F",
                "mac": "Command+Shift+F"
            },
            "description": "__MSG_cmdFill__"
        },
        "fill_chaos": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "__MSG_cmdChaos__"
        },
        "undo_fill": {
            "suggested_key": {
                "default": "Ctrl+Shift+U",
                "mac": "Command+Shift+U"
            },
            "description": "__MSG_cmdUndo__"
        }
    }
}
