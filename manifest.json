{
    "manifest_version": 3,
    "name": "Filler Max",
    "version": "1.1.0",
    "description": "Advanced multi-language form filler for developers and testers.",
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_icon": {
            "16": "icons/logo16.png",
            "48": "icons/logo48.png",
            "128": "icons/logo128.png"
        }
    },
    "icons": {
        "16": "icons/logo16.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/generator.js",
                "scripts/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "options_page": "options/options.html",
    "commands": {
        "fill_form": {
            "suggested_key": {
                "default": "Ctrl+Shift+F",
                "mac": "Command+Shift+F"
            },
            "description": "Fill form with fake data"
        },
        "fill_chaos": {
            "suggested_key": {
                "default": "Ctrl+Shift+D",
                "mac": "Command+Shift+D"
            },
            "description": "Chaos Mode (Fuzz Testing)"
        },
        "undo_fill": {
            "suggested_key": {
                "default": "Ctrl+Shift+U",
                "mac": "Command+Shift+U"
            },
            "description": "Undo fake fill"
        }
    }
}